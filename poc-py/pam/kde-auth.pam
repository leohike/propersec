# lazypass: three auth lines to insert ABOVE the stock "auth substack password-auth" line of
# /etc/pam.d/kde. `just lazypass deploy-pam` installs them as part of pam/kde; INTEGRATION.md covers that step.
#
# tests/test_pam.py builds its PAM stack from this very file, swapping only paths and
# pam_unix, so the control columns tested are the ones that would ship.
#
#   line 1  the short_password: a match ends the stack with success; anything else is ignored
#   line 2  the full_password: a wrong one stops the stack with failure, here, so...
#   line 3  ...allowing the short_password again only ever happens after a correct full_password
#
# The stock "auth substack password-auth" that follows then checks the same full_password again
# and passes; it stays untouched.
auth  [success=done default=ignore]  pam_exec.so quiet quiet_log expose_authtok /usr/local/libexec/lazypass/pam_hook.py check --etc /etc/lazypass --run-base /run/user
auth  [success=ok default=die]       pam_unix.so use_first_pass
auth  optional                       pam_exec.so quiet quiet_log /usr/local/libexec/lazypass/pam_hook.py start-short-password-window --etc /etc/lazypass --run-base /run/user
