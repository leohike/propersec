# properpin's release build: the module, the setgid pinchecker and the command, built with Fedora 44's
# own toolchain and libraries, never the host's, so they load only the system's libraries on any
# Fedora 44, Aurora included. Run it with `just release`, which writes the three files to
# target/properpin, where install.sh looks by default; the build context is the repo root.

FROM registry.fedoraproject.org/fedora:44 AS build
RUN dnf -y install --setopt=install_weak_deps=False rust cargo gcc binutils libxcrypt-devel diffutils && dnf clean all
WORKDIR /src
COPY Cargo.toml Cargo.lock rustfmt.toml ./
COPY crates crates
COPY packaging packaging
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p pam_properpin -p properpin-pinchecker -p properpin-cli \
    && mkdir -p /out \
    && cp target/release/libpam_properpin.so target/release/properpin-pinchecker target/release/properpin /out/ \
    && packaging/install.sh check-build --from /out

# Only the three files, which podman build --output writes out.
FROM scratch
COPY --from=build /out/ /
