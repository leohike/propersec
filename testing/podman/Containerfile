# screenlock-pin's system test: a stock Fedora 44 with screenlock-pin installed by packaging/install.sh and
# its lines put into the real /etc/pam.d/kde by packaging/integrate-into-pam.sh, then exercised
# through the real pam_unix and unix_chkpwd by crates/systest. Run it with `just podman`; the build
# context is the repo root.

# Build with Fedora's own toolchain and libraries, never the host's.
FROM registry.fedoraproject.org/fedora:44 AS build
RUN dnf -y install --setopt=install_weak_deps=False rust cargo gcc libxcrypt-devel && dnf clean all
WORKDIR /src
COPY Cargo.toml Cargo.lock rustfmt.toml ./
COPY crates crates
COPY packaging packaging
COPY testing testing
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p pam_screenlock_pin -p screenlock-pin-checker -p screenlock-pin-cli -p screenlock-pin-systest \
    && mkdir -p /out/build \
    && cp target/release/libpam_screenlock_pin.so target/release/screenlock-pin-checker target/release/screenlock-pin /out/build/ \
    && cp target/release/screenlock-pin-systest /out/
# A PIN checker with a library search path of its own, as Homebrew's toolchain can make one, which
# install must refuse.
RUN echo 'int main(void) { return 0; }' | gcc -x c - -Wl,-rpath,/home/linuxbrew/.linuxbrew/lib -o /out/pin-checker-with-runpath
# The deliberately broken variants the uninstall cases install, built after the real ones.
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target \
    testing/podman/build-broken.sh

FROM registry.fedoraproject.org/fedora:44
# util-linux brings su and login, each with its PAM service, and util-linux-script the terminal the
# command gets to run itself through sudo; install.sh needs diff and cmp, and readelf from binutils
# to check what the binaries load.
RUN dnf -y install --setopt=install_weak_deps=False sudo util-linux util-linux-script diffutils binutils cpio && dnf clean all
# The lock screen's /etc/pam.d/kde exactly as Fedora ships it, without the rest of plasma-workspace.
RUN cd /tmp \
    && dnf -y download plasma-workspace \
    && rpm2cpio plasma-workspace-*.rpm | cpio -idm --quiet ./etc/pam.d/kde \
    && install -m 0644 etc/pam.d/kde /etc/pam.d/kde \
    && rm -rf /tmp/* && dnf clean all
# alice has a PIN; bob is the other user on the machine. install.sh creates the screenlock-pin group.
RUN useradd -m alice && echo 'alice:correct horse battery staple' | chpasswd && useradd -m bob
COPY --from=build /out/ /opt/screenlock-pin/
COPY packaging /opt/screenlock-pin/packaging
CMD ["/opt/screenlock-pin/screenlock-pin-systest", "run"]
